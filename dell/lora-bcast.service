[Unit]
Description=Krisen-Rundruf aus wagodb.loradevice — Alarm, Position, Empfangspegel
Documentation=https://github.com/gerontec/TTN
After=network-online.target mosquitto.service mariadb.service lora-log.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=gh
Group=gh
ExecStart=/usr/bin/python3 /home/gh/python/lora_bcast.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
