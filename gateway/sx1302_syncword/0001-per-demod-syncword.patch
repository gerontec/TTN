+/* -------------------------------------------------------------------------- */
+/* --- PER-DEMODULATOR SYNC WORD OVERRIDE ----------------------------------- */
+
+/* The SX1302 holds four independent RX sync word register pairs:
+     - RX_TOP  SF5        : shared by all 8 multi-SF IF channels, SF5 only
+     - RX_TOP  SF6        : shared by all 8 multi-SF IF channels, SF6 only
+     - RX_TOP  SF7TO12    : shared by all 8 multi-SF IF channels, SF7..SF12
+     - LORA_SERVICE       : the standalone chan_Lora_std demodulator
+   There is no per-IF-channel register, so a single multi-SF channel cannot be
+   given its own sync word. chan_Lora_std can, and is the channel to use for a
+   private / non-LoRaWAN link running alongside the 8 LoRaWAN channels.
+
+   A sync word 0xHL is carried by the two preamble sync symbols; the SX1302
+   stores each as symbol_value/4, i.e. peak_pos = nibble * 2. The field is 5
+   bits and reg_w() masks to that width, so the whole range 0x00..0xFF is
+   reachable -- the 0x12/0x34 restriction is purely a software convention. */
+
+#define SX1302_SW_AUTO      (-1)    /* keep stock lorawan_public behaviour */
+#define SX1302_SW_CONF_PATH "/etc/lora/syncword.conf"
+
+#define SW_PEAK1(sw) ((int32_t)((((uint8_t)(sw)) >> 4) & 0x0F) * 2)
+#define SW_PEAK2(sw) ((int32_t)((((uint8_t)(sw)) >> 0) & 0x0F) * 2)
+
+/* set through lgw_syncword_override(); takes precedence over the conf file */
+static int sw_api_sf5     = SX1302_SW_AUTO;
+static int sw_api_sf6     = SX1302_SW_AUTO;
+static int sw_api_sf7to12 = SX1302_SW_AUTO;
+static int sw_api_service = SX1302_SW_AUTO;
+
+/* Parse one "key = value" line. Value is "auto", 0xNN, or decimal 0..255. */
+static void sw_parse_line(char * line, int * sf5, int * sf6, int * sf7to12, int * service) {
+    char key[32];
+    char val[32];
+    int * target = NULL;
+    long parsed;
+    char * end;
+
+    if (sscanf(line, " %31[A-Za-z0-9_] = %31s", key, val) != 2) {
+        return; /* comment, blank or malformed line */
+    }
+
+    if      (strcmp(key, "sf5")     == 0) target = sf5;
+    else if (strcmp(key, "sf6")     == 0) target = sf6;
+    else if (strcmp(key, "sf7to12") == 0) target = sf7to12;
+    else if (strcmp(key, "service") == 0) target = service;
+    else return;
+
+    if (strcmp(val, "auto") == 0) {
+        *target = SX1302_SW_AUTO;
+        return;
+    }
+
+    errno = 0;
+    parsed = strtol(val, &end, 0); /* base 0 -> accepts 0x.. and decimal */
+    if ((errno != 0) || (end == val) || (*end != '\0') || (parsed < 0) || (parsed > 255)) {
+        printf("WARNING: [syncword] ignoring invalid value \"%s\" for key \"%s\"\n", val, key);
+        return;
+    }
+    *target = (int)parsed;
+}
 
