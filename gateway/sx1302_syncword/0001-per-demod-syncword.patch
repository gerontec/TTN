-        err |= lgw_reg_w(SX1302_REG_RX_TOP_FRAME_SYNCH1_SF7TO12_PEAK2_POS_SF7TO12, 4);
+static void sw_load(int * sf5, int * sf6, int * sf7to12, int * service) {
+    FILE * f;
+    char line[128];
+
+    /* conf file first, so that an unmodified packet forwarder can drive this */
+    f = fopen(SX1302_SW_CONF_PATH, "r");
