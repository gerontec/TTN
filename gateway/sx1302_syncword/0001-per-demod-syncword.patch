+/**
+@brief Override the sync word of each independent SX1302 RX demodulator block.
+
+The SX1302 has no per-IF-channel sync word register: the 8 multi-SF channels
+share one register set, split by spreading factor only. chan_Lora_std (the LoRa
+Service modem) has its own, and is therefore the only channel that can carry a
+sync word different from the LoRaWAN ones.
+
+Must be called before lgw_start(). Values may be any sync word 0x00..0xFF, or
+LGW_SYNCWORD_AUTO to keep the stock behaviour derived from lorawan_public.
+Settings made here take precedence over /etc/lora/syncword.conf.
+
+@param sf5      sync word for the multi-SF block, SF5
+@param sf6      sync word for the multi-SF block, SF6
+@param sf7to12  sync word for the multi-SF block, SF7..SF12
+@param service  sync word for the LoRa Service modem (chan_Lora_std)
+@return LGW_REG_SUCCESS if success, LGW_REG_ERROR otherwise
+*/
+#define LGW_SYNCWORD_AUTO (-1)
+int lgw_syncword_override(int sf5, int sf6, int sf7to12, int service);
+
