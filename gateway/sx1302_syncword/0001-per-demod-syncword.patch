+    if (sw_api_sf6     != SX1302_SW_AUTO) *sf6     = sw_api_sf6;
+    if (sw_api_sf7to12 != SX1302_SW_AUTO) *sf7to12 = sw_api_sf7to12;
+    if (sw_api_service != SX1302_SW_AUTO) *service = sw_api_service;
+}
+
+int lgw_syncword_override(int sf5, int sf6, int sf7to12, int service) {
+    if ((sf5     < SX1302_SW_AUTO) || (sf5     > 255) ||
+        (sf6     < SX1302_SW_AUTO) || (sf6     > 255) ||
+        (sf7to12 < SX1302_SW_AUTO) || (sf7to12 > 255) ||
+        (service < SX1302_SW_AUTO) || (service > 255)) {
+        return LGW_REG_ERROR;
     }
+    sw_api_sf5     = sf5;
+    sw_api_sf6     = sf6;
+    sw_api_sf7to12 = sf7to12;
+    sw_api_service = service;
+    return LGW_REG_SUCCESS;
+}
+
+/* ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
+
+int sx1302_lora_syncword(bool public, uint8_t lora_service_sf) {
+    int err = LGW_REG_SUCCESS;
+    int sf5     = SX1302_SW_AUTO;
+    int sf6     = SX1302_SW_AUTO;
+    int sf7to12 = SX1302_SW_AUTO;
+    int service = SX1302_SW_AUTO;
+
+    sw_load(&sf5, &sf6, &sf7to12, &service);
+
+    /* Resolve "auto" to the stock behaviour, so that an absent or all-auto
+       conf file reproduces the upstream register writes exactly. */
+    if (sf5     == SX1302_SW_AUTO) sf5     = 0x12; /* SF5/SF6 are always private upstream */
+    if (sf6     == SX1302_SW_AUTO) sf6     = 0x12;
+    if (sf7to12 == SX1302_SW_AUTO) sf7to12 = (public == true) ? 0x34 : 0x12;
+    if (service == SX1302_SW_AUTO) {
+        service = ((public == false) || (lora_service_sf == DR_LORA_SF5) || (lora_service_sf == DR_LORA_SF6)) ? 0x12 : 0x34;
+    }
+
+    /* Multi-SF modem configuration (all 8 IF channels) */
+    printf("INFO: [syncword] LoRa Multi-SF  SF5     : 0x%02X\n", (uint8_t)sf5);
+    err |= lgw_reg_w(SX1302_REG_RX_TOP_FRAME_SYNCH0_SF5_PEAK1_POS_SF5, SW_PEAK1(sf5));
+    err |= lgw_reg_w(SX1302_REG_RX_TOP_FRAME_SYNCH1_SF5_PEAK2_POS_SF5, SW_PEAK2(sf5));
+
+    printf("INFO: [syncword] LoRa Multi-SF  SF6     : 0x%02X\n", (uint8_t)sf6);
+    err |= lgw_reg_w(SX1302_REG_RX_TOP_FRAME_SYNCH0_SF6_PEAK1_POS_SF6, SW_PEAK1(sf6));
+    err |= lgw_reg_w(SX1302_REG_RX_TOP_FRAME_SYNCH1_SF6_PEAK2_POS_SF6, SW_PEAK2(sf6));
+
+    printf("INFO: [syncword] LoRa Multi-SF  SF7-SF12: 0x%02X\n", (uint8_t)sf7to12);
+    err |= lgw_reg_w(SX1302_REG_RX_TOP_FRAME_SYNCH0_SF7TO12_PEAK1_POS_SF7TO12, SW_PEAK1(sf7to12));
+    err |= lgw_reg_w(SX1302_REG_RX_TOP_FRAME_SYNCH1_SF7TO12_PEAK2_POS_SF7TO12, SW_PEAK2(sf7to12));
+
+    /* LoRa Service modem configuration (chan_Lora_std, independent) */
+    printf("INFO: [syncword] LoRa Service   SF%-2u    : 0x%02X\n", lora_service_sf, (uint8_t)service);
+    err |= lgw_reg_w(SX1302_REG_RX_TOP_LORA_SERVICE_FSK_FRAME_SYNCH0_PEAK1_POS, SW_PEAK1(service));
+    err |= lgw_reg_w(SX1302_REG_RX_TOP_LORA_SERVICE_FSK_FRAME_SYNCH1_PEAK2_POS, SW_PEAK2(service));
 
     return err;
 }
