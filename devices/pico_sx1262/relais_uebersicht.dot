/* Krisennetz Lenggries -- ein gemeinsamer Kanal, jeder hoert jeden
 * Rendern:  dot -Tpdf relais_uebersicht.dot -o relais_uebersicht.pdf
 */
digraph netz {
    rankdir=TB;
    bgcolor="white";
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    graph [fontname="Helvetica", fontsize=11];

    /* ---- der gemeinsame Aether ---- */
    kanal [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1">
           <TR><TD><B>Gemeinsamer Kanal</B></TD></TR>
           <TR><TD>868.125 MHz &#183; SF7 &#183; BW 125 kHz</TD></TR>
           <TR><TD>Syncword 0x34 &#183; CRC an</TD></TR>
           <TR><TD>25 mW ERP &#183; 1 % Sendezeit</TD></TR>
           </TABLE>>,
           shape=box, style="filled,rounded", fillcolor="#fff6d9",
           color="#c8922a", penwidth=2];

    /* ---- Stationen ---- */
    pico [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1">
          <TR><TD><B>Relais Brauneck</B> ~1550 m</TD></TR>
          <TR><TD>Pico + Waveshare SX1262</TD></TR>
          <TR><TD>MicroPython 1.28 &#183; 48 MHz</TD></TR>
          <TR><TD>gibt jedes Paket <B>einmal</B> weiter</TD></TR>
          <TR><TD>h&#246;chstens 3 Spr&#252;nge</TD></TR>
          <TR><TD>solar, ohne Puffer</TD></TR>
          </TABLE>>,
          shape=box, style="filled,rounded", fillcolor="#fdf3e3",
          color="#c8922a", penwidth=2];

    gw [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1">
        <TR><TD><B>DLOS8N Lenggries</B> ~680 m</TD></TR>
        <TR><TD>chan_Lora_std auf 868.125</TD></TR>
        <TR><TD>server3 &#8594; UDP 1702</TD></TR>
        </TABLE>>,
        shape=box, style="filled,rounded", fillcolor="#eef7ee", color="#4a8f4a"];

    dell [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1">
          <TR><TD><B>dell-3660</B> 192.168.5.23</TD></TR>
          <TR><TD>lora_raw.py &#183; lora_cmd.py</TD></TR>
          <TR><TD>MQTT lora/raw</TD></TR>
          </TABLE>>,
          shape=box, style="filled,rounded", fillcolor="#eef7ee", color="#4a8f4a"];

    trackerd [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1">
              <TR><TD><B>TrackerD</B> im Feld</TD></TR>
              <TR><TD>P2P v1.3 in app1</TD></TR>
              <TR><TD>Syncword 0x34 ab Werk</TD></TR>
              </TABLE>>,
              shape=box, style="filled,rounded", fillcolor="#eaf1fb", color="#1b6ec2"];

    la66 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1">
          <TR><TD><B>LA66</B></TD></TR>
          <TR><TD>nur im <B>P2P</B>-Modus dabei</TD></TR>
          <TR><TD>in LoRaWAN nicht Teil des Netzes</TD></TR>
          </TABLE>>,
          shape=box, style="filled,rounded,dashed", fillcolor="#eaf1fb",
          color="#7a9cc2"];

    bh [label="Bad Heilbrunn ~640 m\nEmpfangsstation\n(noch nicht aufgebaut)",
        shape=box, style="filled,rounded,dashed", fillcolor="#f4f4f4",
        color="#999999", fontcolor="#555555"];

    /* ---- alle haengen am selben Kanal ---- */
    edge [dir=both, color="#c8922a", penwidth=2];
    pico     -> kanal [label="  h&#246;rt alles,\l  gibt einmal weiter\l"];
    gw       -> kanal [label="  h&#246;rt + sendet\l"];
    trackerd -> kanal [label="  h&#246;rt + sendet\l"];
    la66     -> kanal [label="  nur als P2P\l", style=dashed, color="#7a9cc2"];
    bh       -> kanal [label="  geplant\l", style=dashed, color="#999999"];

    edge [dir=forward, color="#4a8f4a", penwidth=1, style=solid];
    gw -> dell [label="  Semtech-UDP 1702\l  roh, unentschl&#252;sselt\l"];
    dell -> gw [label="  senden via\l  127.0.0.1:1703\l", color="#c25a1b"];

    { rank=same; pico; trackerd; }
    { rank=same; gw; la66; }
}
