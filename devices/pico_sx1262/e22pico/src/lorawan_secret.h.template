// lorawan_secret.h.template -- template for this node's AppKey.
//
// Copy to src/lorawan_secret.h and fill in your own key; that file stays out
// of git (.gitignore) and is not embedded into the source carried in flash
// either, so `src` on the console does not give the key away. It is still in
// the binary -- a node someone walks off with hands over its AppKey. With OTAA
// that is unavoidable.
//
// Generate it and set both sides to the same value:
//
//   KEY=$(openssl rand -hex 16)
//   APPKEY=$KEY /home/gh/.venv-chirpstack/bin/python cs_pico.py   # on the dell
//   # enter the same 16 bytes here, and only then build
//
// Mind the order: key first, then `pio run`. A build before that flashes the
// zero placeholder from lorawanparms.h, and the network server will report
// nothing but a terse "Invalid MIC".

#ifndef LORAWAN_SECRET_H
#define LORAWAN_SECRET_H

#define LW_APP_KEY { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
                     0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }

#endif // LORAWAN_SECRET_H
